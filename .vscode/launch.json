{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Cargo launch",
      "cargo": {
        "args": [
          "build",
          "--lib"
        ]
      },
      "args": []
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug executable 'lale'",
      "cargo": {
        "args": [
          "build",
          "--bin=lale",
          "--package=lale"
        ],
        "filter": {
          "name": "lale",
          "kind": "bin"
        }
      },
      "args": ["run", "--print-ast", "--print-symbols", "examples/complex.lale"],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug unit tests in executable 'lale'",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--bin=lale",
          "--package=lale"
        ],
        "filter": {
          "name": "lale",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    }
  ]
}
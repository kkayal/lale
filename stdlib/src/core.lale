// Lale Standard Library - Core Level
// Core memory management and string operations

// ============================================================================
// FFI Signatures for Memory Management
// ============================================================================

// Allocate memory from C runtime (for C library integration)
// Wrapper for C malloc: reserves 'size' bytes and returns a pointer
import fn signature malloc(size as u64) returns pointer

// Copy memory between two regions (for C library integration)
// Wrapper for C memcpy: copies 'count' bytes from src to dest
import fn signature memcpy(dest as pointer, src as pointer, count as u64) returns pointer

// Set memory region to a value (for C library integration)
// Wrapper for C memset: sets 'count' bytes starting at ptr to value
import fn signature memset(ptr as pointer, value as i32, count as u64) returns pointer

// ============================================================================
// Memory Management Hooks
// ============================================================================

// Memory allocation hook
// Wrapper around C malloc
export fn __lale_malloc(size as u64) returns pointer
    return malloc(size)
end fn

// Memory set helper (used for initializing memory regions)
// Sets 'count' bytes starting at 'ptr' to the value
export fn __lale_memset(ptr as pointer, value as i32, count as u64) returns pointer
    return memset(ptr, value, count)
end fn

// ============================================================================
// String Concatenation (Handled by Concat IR Instruction)
// ============================================================================

// Note: String concatenation (a ~ b) is handled directly by the Concat IR instruction
// in both the interpreter and LLVM backends, not by calling a stdlib function.
// This function is kept here for reference but is not used by the compiler.

// ============================================================================
// String Parsing Functions (C standard library)
// ============================================================================

// C standard library parsing functions.
// text expects null-terminated data (all Lale text values are null-terminated).

import fn signature strtod(nptr as pointer, endptr as pointer) returns f64
import fn signature strtol(nptr as pointer, endptr as pointer, base as i32) returns i64
import fn signature strtoul(nptr as pointer, endptr as pointer, base as i32) returns u64

/// Parse a string to a 64-bit floating-point number.
/// Returns nothing if the string is empty or contains invalid input.
export fn parse_float(ref input as text) returns f64?
    when input.chars == 0 as u64
        return nothing
    end when
    var endptr as pointer = 0 as pointer
    var val as f64 = strtod(input.ptr, pointer to endptr)
    // strtod sets *endptr = nptr on failure (no digits consumed)
    when endptr == input.ptr
        return nothing
    end when
    return val
end fn

/// Parse a string to a signed 64-bit integer (base 10).
/// Returns nothing if the string is empty, invalid, or not a whole number.
export fn parse_int(ref input as text) returns i64?
    when input.chars == 0 as u64
        return nothing
    end when
    var endptr as pointer = 0 as pointer
    var val as i64 = strtol(input.ptr, pointer to endptr, 10 as i32)
    // strtol sets *endptr = nptr on failure (no digits consumed)
    when endptr == input.ptr
        return nothing
    end when
    return val
end fn

/// Parse a string to an unsigned 64-bit integer (base 10).
/// Returns nothing if the string is empty, invalid, negative, or not a whole number.
export fn parse_uint(ref input as text) returns u64?
    when input.chars == 0 as u64
        return nothing
    end when
    var endptr as pointer = 0 as pointer
    var val as u64 = strtoul(input.ptr, pointer to endptr, 10 as i32)
    // strtoul sets *endptr = nptr on failure (no digits consumed)
    when endptr == input.ptr
        return nothing
    end when
    return val
end fn

// ============================================================================
// Time: Monotonic boot-relative elapsed time
// ============================================================================

// POSIX `struct timespec`: whole seconds plus sub-second nanoseconds.
//
// Field signedness is deliberate and mirrors the C ABI, not Lale semantics:
//   - `tv_sec` is C `time_t` (signed). It must be signed because the same struct
//     is used by CLOCK_REALTIME, where times before the Unix epoch (pre-1970)
//     are negative. CLOCK_BOOTTIME reuses this struct but only ever fills it
//     with non-negative seconds.
//   - `tv_nsec` is C `long` (signed), but POSIX constrains its value to
//     [0, 999999999] — always non-negative.
//
// Both fields are therefore `i64` (faithful to POSIX), even though the return
// of __lale_read_uptime is `u64` (see the wrapper below).
type timespec
    tv_sec as i64
    tv_nsec as i64
end type

// POSIX clock_gettime: reads a clock into a timespec via an out-parameter.
// clock_id selects the clock; 7 = CLOCK_BOOTTIME (monotonic, includes suspend).
import fn signature clock_gettime(clock_id as i32, tp as pointer) returns i32

// Monotonic boot-relative elapsed time in nanoseconds.
// Wraps clock_gettime(CLOCK_BOOTTIME, &ts) and scales seconds to nanoseconds.
export fn __lale_read_uptime() returns u64 in <ns>
    var ts as timespec = timespec(0, 0)
    // clock_gettime(CLOCK_BOOTTIME) never fails (clock 7 is always valid), so
    // the return code is discarded.
    var _ as i32 = clock_gettime(7 as i32, pointer to ts)
    var secs as i64 = ts.tv_sec
    var nsecs as i64 = ts.tv_nsec

    // The two `unsafe bitcast ... as u64` casts reinterpret a signed i64 as an
    // unsigned u64. They are SAFE, for the exact reason the public return type
    // is `u64`:
    //
    // (1) tv_sec → u64: under CLOCK_BOOTTIME the seconds value is always >= 0
    //     (boot is the origin; there are no pre-boot readings). A non-negative
    //     i64 and its u64 counterpart share the identical two's-complement bit
    //     pattern, so the reinterpretation is value-preserving. (The signedness
    //     of `time_t` only matters for CLOCK_REALTIME, which this wrapper never
    //     reads.)
    //
    // (2) tv_nsec → u64: POSIX guarantees the nanosecond field lies in
    //     [0, 999999999], i.e. never negative, so the same non-negative bit
    //     pattern argument applies.
    var secs_u as u64 = unsafe bitcast secs as u64
    var nsecs_u as u64 = unsafe bitcast nsecs as u64

    // Scale seconds to nanoseconds and add the sub-second part. The result is a
    // plain (unitless) u64; tagging it `in <ns>` here is what gives the function
    // its declared unit without any dimensional seconds→nanoseconds conversion.
    var total as u64 in <ns> = secs_u * 1000000000 as u64 + nsecs_u
    return total
end fn

{
  // markdownlint configuration for Lale documentation.
  //
  // The docs are intentionally dense technical references with long table
  // rows, manual list numbering, inline HTML for images, and a table of
  // contents whose anchors are generated by the renderer. The following
  // rules are disabled because they don't fit this style.
  "config": {
    "MD013": false, // line-length (tables and code identifiers exceed 80)
    "MD022": false, // blanks-around-headings (conflicts with prettier heading/list layout)
    "MD024": false, // no-duplicate-heading (TODO.md repeats Status/Fix/etc.)
    "MD029": false, // ordered-list-item-prefix (TODO.md uses manual numbering)
    "MD033": false, // no-inline-html (docs use <img> for the logo)
    "MD036": false, // no-emphasis-as-heading (bold callouts used as headings)
    "MD041": false, // first-line-heading (docs start with an image)
    "MD051": false // link-fragments (renderer-generated heading anchors)
  },
  "globs": ["doc/*.md", "README.md"]
}

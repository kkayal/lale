use std: absf, __lale_pow

// ════════════════════════════════════════════════════════════════
//  Balloon Simulation — Euler integration with ISA atmosphere
//  Starting conditions: sea level, 20 °C, m=0.5 kg, V=2.0 m³
//  Launch altitude: 300 m
// ════════════════════════════════════════════════════════════════

// ── Atmosphere constants ──
var g as f64 in <m/s²> = 9.80665      // gravitational acceleration
var p₀ as f64 in <kg/m⋅s²> = 101325.0 // sea‑level air pressure
var T₀ as f64 in <K> = 293.15         // sea‑level temperature (20 °C)
var L as f64 in <K/m> = 0.0065        // tropospheric lapse rate
var R as f64 in <m²/s²⋅K> = 287.058   // gas constant for dry air

// ── Balloon ──
var m as f64 in <kg> = 0.5            // total mass (envelope + payload + gas)
var V as f64 in <m³> = 2.0            // balloon volume
var Cd as f64 = 0.47                  // drag coefficient (sphere, dimensionless)
var π as f64 = 3.141592653589793

// Cross‑sectional area: A = π · r²
var r as f64 in <m> = __lale_pow(3.0 ⋅ V / (4.0 ⋅ π), 1.0 / 3.0)  // radius
var A as f64 in <m²> = π ⋅ r ⋅ r      // frontal area

// ── Simulation control ──
var Δt as f64 in <s> = 0.1            // time step
var tMax as f64 in <s> = 5.0          // maximum simulation time
var hMax as f64 in <m> = 500.0        // altitude limit (exit above this)

var h₀ as f64 in <m> = 300.0          // launch altitude
var t as f64 in <s> = 0.0             // elapsed time
var h as f64 in <m> = h₀              // current altitude
var v as f64 in <m/s> = 0.0           // vertical velocity (↑ positive)
var zeroH as f64 in <m> = 0.0         // ground reference

//
// ── International Standard Atmosphere (ISA, troposphere h < 11 km) ──
//


// Temperature at altitude h
fn T(h as f64 in <m>) returns f64 in <K>
    return T₀ - L ⋅ h
end fn

// Pressure at altitude h:  p(h) = p₀ · (T/T₀)^(g/(R·L))
fn p(h as f64 in <m>) returns f64 in <kg/m⋅s²>
    var κ as f64 = g / (R ⋅ L)
    var ratio as f64 = (T₀ - L ⋅ h) / T₀
    return p₀ ⋅ __lale_pow(ratio, κ)
end fn

// Air density at altitude h (ideal gas law)
fn ρ(h as f64 in <m>) returns f64 in <kg/m³>
    return p(h) / (R ⋅ T(h))
end fn

//
// ── Forces on the balloon ──
//

// Buoyant lift:  F_b = ρ(h) · V · g
fn boyancy(h as f64 in <m>) returns f64 in <kg⋅m/s²>
    return ρ(h) ⋅ V ⋅ g
end fn

// Quadratic drag (opposes motion):  F_d = ½ · Cd · ρ · A · v · |v|
fn drag(h as f64 in <m>, v as f64 in <m/s>) returns f64 in <kg⋅m/s²>
    return 0.5 ⋅ Cd ⋅ ρ(h) ⋅ A ⋅ v ⋅ absf(v)
end fn

fn acceleration(h as f64 in <m>, v as f64 in <m/s>) returns f64 in <m/s²>
    return (boyancy(h) - m ⋅ g - drag(h, v)) / m
end fn

// ── Simulation loop (Euler integration) ──
write "t,h,v,a,lift,drag,rho,pressure,temp"
write "s,m,m/s,m/s²,N,N,kg/m³,Pa,K"

loop
    var a as f64 in <m/s²> = acceleration(h, v)
    var lift as f64 in <kg⋅m/s²> = boyancy(h)
    var d as f64 in <kg⋅m/s²> = drag(h, v)

    write "{t},{h},{v},{a},{lift},{d},{ρ(h)},{p(h)},{T(h)}"

    // Euler step:  v = v₀ + a·Δt,  h = h₀ + v·Δt
    v += a ⋅ Δt
    h += v ⋅ Δt
    t += Δt

    when h >= hMax exit loop end when
    when h < zeroH exit loop end when
end loop when t >= tMax

write "Simulation complete"

// Import `absf` (the absolute-value function for floats) from the standard
// library.
use absf from std.full

// This file and balloon_classic_programming.lale run the SAME simulation. This
// one uses "physics book" notation — Unicode subscripts `p₀`, `Δt`, operators
// like `⋅` and `²`, and Greek letters `ρ`, `π`. The other uses "classic
// programming" notation (ASCII `p0`, `dt`, `*`, `^`). Compare them side by side.

// ════════════════════════════════════════════════════════════════
// Balloon Simulation — semi-implicit Euler integration
// with a simplified ISA-based atmosphere
//
// Initial conditions:
//   launch altitude: 300 m
//   balloon mass: 2.0 kg
//   balloon volume: 2.0 m³
//
// The balloon is modeled as a sphere with constant volume.
// ════════════════════════════════════════════════════════════════


// ── Atmosphere constants ───────────────────────────────────────
//
// Simplified ISA-based troposphere:
//   sea-level pressure:    101325 Pa
//   sea-level temperature: 15 °C
//   temperature lapse rate: 6.5 K/km
//
// Note: Standard ISA uses 15 °C at sea level. This simulation
// deliberately uses 15 °C as its sea-level reference temperature.

var g as f64 = 9.80665 <m/s²>         // gravitational acceleration
var p₀ as f64 = 101325.0 <kg/m⋅s²>    // sea-level air pressure 1013.25 Pa
var T₀ as f64 = 288.15 <K>            // sea-level temperature (15 °C)
var L as f64 = 0.0065 <K/m>           // tropospheric lapse rate 6.5 K/km
var R as f64 = 287.052874 <m²/s²⋅K>   // specific gas constant for dry air 287.052874 J/(kg⋅K)

// ── Balloon ────────────────────────────────────────────────────
//
// The total mass includes envelope, payload, and lifting gas.
// Volume is assumed to remain constant during the simulation.

var m as f64 in <kg> = 2.0            // total balloon mass
var V as f64 in <m³> = 2.0            // balloon volume
var Cd as f64 = 0.47                  // drag coefficient of a sphere
// var π as f64 = 3.141592653589793   // π is predefined in Lale


// Cross-sectional area of a sphere:
//   V = 4/3 ⋅ π ⋅ r³
//
// Therefore:
//   r = (3 ⋅ V / (4 ⋅ π))^(1/3)

// No warning about division by zero, because the compiler has checked
// that π has never been changed and cannot be changed by pointers etc.
var r as f64 in <m> = (3.0 ⋅ V / (4.0 ⋅ π)) ^ (1.0 / 3.0)
var A as f64 in <m²> = π ⋅ r²


// ── Simulation control ─────────────────────────────────────────

var Δt as f64 in <s> = 0.1               // time step
var tMax as f64 in <s> = 5.0             // maximum simulation time
var hMax as f64 in <m> = 500.0           // stop above this altitude

var h₀ as f64 in <m> = 300.0             // launch altitude
var t as f64 in <s> = 0.0                // elapsed time
var h as f64 in <m> = h₀                 // current altitude
var v as f64 in <m/s> = 0.0              // vertical velocity (upward positive)
var zeroH as f64 in <m> = 0.0            // ground reference


//
// ── Atmosphere ─────────────────────────────────────────────────
//
// Temperature:
//   T(h) = T₀ - L ⋅ h
//
// Pressure:
//   p(h) = p₀ ⋅ (T(h) / T₀)^(g / (R ⋅ L))
//
// Air density:
//   ρ(h) = p(h) / (R ⋅ T(h))
//
// The model is valid within the troposphere for this simplified
// simulation.
//

fn T(h as f64 in <m>) returns f64 in <K>
    return T₀ - L ⋅ h
end fn


fn p(h as f64 in <m>) returns f64 in <kg/m⋅s²>
    var κ as f64 = g / (R ⋅ L)
    var ratio as f64 = T(h) / T₀
    return p₀ ⋅ ratio ^ κ
end fn

// The compiler warns about a potential division by zero unless we guard the
// denominator, so we check `R ⋅ T(h)` before dividing.
fn ρ(h as f64 in <m>) returns f64 in <kg/m³>
    if R ⋅ T(h) != 0                  // prevent division by zero
        return p(h) / (R ⋅ T(h))      // guarded → no warning
    else
        alert "Division by zero in function {#function_name} in file {#source_file} line {#source_line}"
        exit(1)
    end if
end fn


//
// ── Forces on the balloon ──────────────────────────────────────
//


// Buoyant force:
//   F_b = ρ(h) ⋅ V ⋅ g
//
// The buoyant force acts upward.

fn buoyancy(h as f64 in <m>) returns f64 in <kg⋅m/s²>
    return ρ(h) ⋅ V ⋅ g
end fn


// Aerodynamic drag:
//   F_d = -½ ⋅ Cd ⋅ ρ ⋅ A ⋅ v ⋅ |v|
//
// The sign ensures that drag always opposes the direction of motion.

fn drag(h as f64 in <m>, v as f64 in <m/s>) returns f64 in <kg⋅m/s²>
    return -0.5 ⋅ Cd ⋅ ρ(h) ⋅ A ⋅ v ⋅ absf(v)
end fn


// Net acceleration:
//   a = (F_b - m⋅g + F_d) / m

fn acceleration(h as f64 in <m>, v as f64 in <m/s>) returns f64 in <m/s²>
    return (buoyancy(h) - m ⋅ g + drag(h, v)) / m
end fn


// ── Simulation loop ─────────────────────────────────────────────
//
// Semi-implicit Euler integration:
//   vₙ₊₁ = vₙ + aₙ ⋅ Δt
//   hₙ₊₁ = hₙ + vₙ₊₁ ⋅ Δt
//

// Print a CSV header, with units on the second line, so the results can be
// plotted or opened in a spreadsheet.
write "t,h,v,a,buoyancy,drag,rho,pressure,temp"
write "s,m,m/s,m/s²,N,N,kg/m³,Pa,K"

loop
    var a as f64 in <m/s²> = acceleration(h, v)
    var lift as f64 in <kg⋅m/s²> = buoyancy(h)
    var d as f64 in <kg⋅m/s²> = drag(h, v)

    write "{t},{h},{v},{a},{lift},{d},{ρ(h)},{p(h)},{T(h)}"

    // Semi-implicit Euler step
    v += a ⋅ Δt
    h += v ⋅ Δt
    t += Δt

    when h >= hMax exit loop end when
    when h < zeroH exit loop end when
end loop when t >= tMax

write "Simulation complete"

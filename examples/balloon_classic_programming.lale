use std: absf, __lale_pow

// ════════════════════════════════════════════════════════════════
//  Balloon Simulation — Euler integration with ISA atmosphere
//  Starting conditions: sea level, 20 °C, m=0.5 kg, V=2.0 m³
//  Launch altitude: 300 m
// ════════════════════════════════════════════════════════════════

// ── Atmosphere constants ──
var g as f64 in <m/s^2> = 9.80665               // gravitational acceleration
var p0 as f64 in <kg/m*s^2> = 101325.0           // sea-level air pressure
var T0 as f64 in <K> = 293.15                    // sea-level temperature (20 °C)
var L as f64 in <K/m> = 0.0065                   // tropospheric lapse rate
var R as f64 in <m^2/s^2*K> = 287.058            // gas constant for dry air

// ── Balloon ──
var m as f64 in <kg> = 0.5                       // total mass (envelope + payload + gas)
var V as f64 in <m^3> = 2.0                      // balloon volume
var Cd as f64 = 0.47                             // drag coefficient (sphere, dimensionless)
var pi as f64 = 3.141592653589793

// Cross-sectional area: A = pi * r^2
var r as f64 in <m> = __lale_pow(3.0 * V / (4.0 * pi), 1.0 / 3.0) // radius
var A as f64 in <m^2> = pi * r * r               // frontal area

// ── Simulation control ──
var dt as f64 in <s> = 0.1                       // time step
var tMax as f64 in <s> = 5.0                     // maximum simulation time
var hMax as f64 in <m> = 500.0                   // altitude limit (exit above this)

var h0 as f64 in <m> = 300.0                     // launch altitude
var t as f64 in <s> = 0.0                        // elapsed time
var h as f64 in <m> = h0                         // current altitude
var v as f64 in <m/s> = 0.0                      // vertical velocity (up = positive)
var zeroH as f64 in <m> = 0.0                    // ground reference

//
// ── International Standard Atmosphere (ISA, troposphere h < 11 km) ──
//


// Temperature at altitude h
fn T(h as f64 in <m>) returns f64 in <K>
    return T0 - L * h
end fn

// Pressure at altitude h:  p(h) = p0 * (T/T0)^(g/(R*L))
fn p(h as f64 in <m>) returns f64 in <kg/m*s^2>
    var kappa as f64 = g / (R * L)
    var ratio as f64 = (T0 - L * h) / T0
    return p0 * __lale_pow(ratio, kappa)
end fn

// Air density at altitude h (ideal gas law)
fn rho(h as f64 in <m>) returns f64 in <kg/m^3>
    return p(h) / (R * T(h))
end fn

//
// ── Forces on the balloon ──
//

// Buoyant lift:  F_b = rho(h) * V * g
fn boyancy(h as f64 in <m>) returns f64 in <kg*m/s^2>
    return rho(h) * V * g
end fn

// Quadratic drag (opposes motion):  F_d = 0.5 * Cd * rho * A * v * |v|
fn drag(h as f64 in <m>, v as f64 in <m/s>) returns f64 in <kg*m/s^2>
    return 0.5 * Cd * rho(h) * A * v * absf(v)
end fn

// Net acceleration:  a = (F_b - F_g - F_d) / m
fn acceleration(h as f64 in <m>, v as f64 in <m/s>) returns f64 in <m/s^2>
    return (boyancy(h) - m * g - drag(h, v)) / m
end fn

// ── Simulation loop (Euler integration) ──
write "t,h,v,a,lift,drag,rho,pressure,temp"
write "s,m,m/s,m/s^2,N,N,kg/m^3,Pa,K"

loop
    var a as f64 in <m/s^2> = acceleration(h, v)
    var lift as f64 in <kg*m/s^2> = boyancy(h)
    var d as f64 in <kg*m/s^2> = drag(h, v)

    write "{t},{h},{v},{a},{lift},{d},{rho(h)},{p(h)},{T(h)}"

    // Euler step:  v = v0 + a*dt,  h = h0 + v*dt
    v += a * dt
    h += v * dt
    t += dt

    if h >= hMax
        exit loop
    end if
    if h < zeroH
        exit loop
    end if
end loop when t >= tMax

write "Simulation complete"

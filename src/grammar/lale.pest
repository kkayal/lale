// ==================== FILE HEADER ====================
// Lale Programming Language Grammar
// This file defines the complete syntax for the Lale language
// using Pest parser generator syntax.

// ==================== MAIN PROGRAM STRUCTURE ====================
// Top-level program definition

program = { SOI ~ (s | NEWLINE)* ~ statement ~ (sd ~ statement)* ~ os_ln ~ EOI }
exit_program = { statement_comments ~ kw_exit_program ~ (ms_ln ~ int)? ~ (info)? }

// ==================== WHITESPACE AND DELIMITERS ====================
// Whitespace handling and statement separation

s = _{ " " | "\t" | "\r" | ("\\\n") }
os = _{ s* }  // optional space
ms = _{ s+ }  // mandatory space
os_ln = _{ info? ~ (s | NEWLINE)* }
ms_ln = _{ info? ~ (s | NEWLINE)+ }
sd = _{ (os ~ (NEWLINE | ";") ) + ~ os } // statement delimiter

// ==================== COMMENTS AND DOCUMENTATION ====================
// doc comments with triple slashes are a special form of comments.
// They are used for documentation purposes.
// comments with double slashes are not included in documentation.
// They are used for debugging and explanation of the code for better maintenance

double_slash = _{ "//" }
triple_slash = _{ "///" }

content = @{ (!NEWLINE ~ ANY)* }

info = { os ~ (doc | comment) }
doc = { triple_slash ~ os ~ content }
comment = { double_slash ~ os ~ content }

// Collects leading comment/doc lines followed by optional indentation.
// Comment lines directly above a statement attach as its leading comments; the
// trailing `os` tolerates the indentation of nested statements (function,
// loop, and test-case bodies are indented). A comment separated from the next
// statement by a blank line is NOT consumed here and falls through to the
// standalone `info` alternative in the `statement` rule.
statement_comments = _{ (info ~ NEWLINE)* ~ os }

// ==================== BASIC TOKENS ====================
// Fundamental building blocks - no dependencies

// Character classes and basic patterns
// alpha: single_identifier start characters (letters + underscore)
alpha = { (ASCII_ALPHA | "_" | letter_ranges) }
digit = { '0'..'9' }
subscript_digits   = { '\u{2080}'..'\u{2089}' }

// ==================== STATEMENT KEYWORDS ====================
// Named keyword rules serve two purposes:
//
// 1. Multi-use keywords — defined once, referenced everywhere.
//    Changing a keyword's spelling updates every rule atomically.
//    These need no PEG disambiguation; they simply eliminate
//    copy-paste drift.
//
// 2. Statement-starting tokens — a concise registry of every
//    token that can begin a statement. Adding a new statement
//    type requires defining its kw_ rule here.
//
// All kw_ rules are silent (no parse tree nodes).
//
// Multi-use keywords (DRY) — defined once, referenced across multiple rules.
// Normal rules (= no underscore) when builders need to detect their
// presence (optional position: copy, export, import, private, not).
// Silent rules (= underscore) when always mandatory in context
// (as, in, nothing, to, unsafe, value at, returns).
kw_as         = _{ "as" }
kw_bitcast       = _{ "bitcast" }
kw_decl       = _{ "decl" }
kw_in         = _{ "in" }
kw_nothing    = _{ "nothing" }
kw_to         = _{ "to" }
kw_unsafe     = _{ "unsafe" }
kw_value_at   = _{ "value at" }
kw_returns    = _{ "returns" }
kw_copy       = { "copy" }
kw_ref        = { "ref" }
kw_export     = { "export" }
kw_import     = { "import" }
kw_not        = { "not" }
kw_private    = { "private" }
//
// Statement-starting tokens — always silent, always mandatory.
kw_type   = _{ "type" }
kw_var    = _{ "var" }
kw_fn     = _{ "fn" }
kw_use    = _{ "use" }
kw_from   = _{ "from" }
kw_all    = _{ "all" }
kw_if     = _{ "if" }
kw_loop   = _{ "loop" }
kw_return = _{ "return" }
kw_debug  = _{ "debug" }
kw_log    = _{ "log" }
kw_rewind      = _{ "rewind" }
kw_exit_loop   = _{ "exit loop" }
kw_exit_program = _{ "exit program" }
kw_assert      = _{ "assert" }
kw_enum        = _{ "enum" }
kw_switch      = _{ "switch" }
kw_match       = _{ "match" }
kw_default     = _{ "default" }
kw_case        = _{ "case" }
kw_when        = _{ "when" }
kw_move_on     = _{ "move on" }
kw_missing_code = _{ "missing code" }
kw_allocate    = _{ "allocate" }
kw_release     = _{ "release" }
kw_on_exit     = _{ "on exit" }
kw_test_suite  = _{ "test suite" }
kw_test_case   = _{ "test case" }


// ==================== IDENTIFIERS ====================
// Identifiers must start with alpha (letter, underscore, or supported
// Unicode) but can contain subscript digits and digits in subsequent
// positions. No keywords are reserved — statement/expression-level
// disambiguation is handled by PEG ordered choice.

// A single identifier component — one name segment, no link symbols.
// Used for variable names, function names, type names, and as building
// blocks for path names.
single_identifier = @{ alpha ~ identifier_continue* }

// Characters allowed after the first character of an identifier.
// Includes letters, digits, subscript digits, and combining marks.
identifier_continue = { alpha | digit | subscript_digits | combining_marks }

// A path name: one or more identifiers joined by `.`.
// Used in module imports (`use std.file_io_posix`) and function-call targets
// (`std.io.println(...)`, `obj.method(...)`).
// Non-atomic: the builder receives separate single_identifier nodes.
qualified_identifier = { single_identifier ~ (os_ln ~ "." ~ os_ln ~ single_identifier)* }

// ==================== LITERALS ====================
// Atomic values - numbers, strings, characters, booleans

// Number components
sign = { plus | minus }
plus = { "+" }
minus = { "-" }
float = @{ sign? ~ (decimal_with_exp | decimal_only | integer_with_exp) }
decimal_with_exp = @{ digit+ ~ "." ~ digit+ ~ ("e"|"E") ~ sign? ~ digit+ }
decimal_only = @{ digit+ ~ "." ~ digit+ }
integer_with_exp = @{ digit+ ~ ("e"|"E") ~ sign? ~ digit+ }
int = @{ sign? ~ digit+ ~ !"." }
u_int = @{ "+"? ~ digit+ ~ !"." }

// Characters and strings
hex = { '0'..'9' | 'A'..'F' | 'a'..'f' }
character = {
  "\\" ~ ("n"|"r"|"t"|"'"|"\""|"\\") |
  "\\" ~ ("u"|"U") ~ "+" ~ hex{6} |
  !("\\" | NEWLINE) ~ ANY
}
s_literal = { "\"" ~ (embedded_value | string_text)* ~ "\"" }
embedded_value = { "{" ~ os ~ expression ~ os ~ "}" }
string_text = @{ (!"{" ~ !"\"" ~ character)+ }

// Triple-quoted strings: multi-line text that may contain unescaped quotes.
// Embedded expressions (`{expr}`) are supported; everything else is literal text.
triple_string = { "\"\"\"" ~ (embedded_value | triple_text)* ~ "\"\"\"" }
triple_text = @{ (!"{" ~ !"\"\"\"" ~ ANY)+ }

// Literal types
c_literal = @{ "'" ~ (!"'" ~ character) ~ "'" }
b_literal = { "true" | "false" }
n_literal = { (float | u_int | int) ~ (os ~ &"<" ~ unit)? }
h_literal = @{ "0x" ~ hex+ }
a_literal = {
    "[" ~ os_ln ~ "]" |
    "[" ~ os_ln ~ "fill" ~ ms_ln ~ "with" ~ ms_ln ~ expression ~ os_ln ~ "]" |
    "[" ~ os_ln ~ expression ~ (os_ln ~ "," ~ os_ln ~ expression)* ~ (os_ln ~ ",")? ~ os_ln ~ "]"
}

// ==================== TYPES ====================
// Type system definitions

// Primitive types
u8 = { "u8" }
i8 = { "i8" }
u16 = { "u16" }
i16 = { "i16" }
u32 = { "u32" }
i32 = { "i32" }
u64 = { "u64" }
i64 = { "i64" }
f16 = { "f16" }
f32 = { "f32" }
f64 = { "f64" }
text = { "text" }
bool = { "bool" }
byte = { "byte" }
char = { "char" }
pointer = { "pointer" ~ !(ms_ln ~ "to") }

// Composite types
// Supports: i32, text, pointer, i32[5], i32[n], [i32], etc.
// Vector types: vec2 of T, vec3 of T, vec4 of T
//   `of` = what it's made of (storage), `in` = what it represents (physics)
optional_marker = _{ "?" }
vector_kind = { "vec2" | "vec3" | "vec4" }
vector_type = { vector_kind ~ ms_ln ~ "of" ~ ms_ln ~ type_name }
type_name = {
  vector_type |
  ("[" ~ os ~ (u8 | i8 | u16 | i16 | u32 | i32 | u64 | i64 |
    f16 | f32 | f64 | text | bool | byte | char | pointer | single_identifier) ~ os ~ "]" ~ optional_marker?) |
  ((u8 | i8 | u16 | i16 | u32 | i32 | u64 | i64 |
    f16 | f32 | f64 | text | bool | byte | char | pointer | single_identifier) ~ arr_index? ~ optional_marker?)
}
arr_index = { ("[" ~ os ~ expression ~ os ~ "]")+ }

// ==================== PHYSICAL UNITS ====================

unit = @{ "<" ~ ((float ~ mul_sign)? ~ dividend ~ (div_sign ~ divisor)? | (float ~ div_sign ~ divisor)) ~ ">" }
mul_sign = _{ "⋅" | "*" }
div_sign = _{ "÷" | "⁄" | "∕" | "/" }
dividend = { atomic_unit ~ exponent? ~ (mul_sign ~ atomic_unit ~ exponent?)* }
divisor = { atomic_unit ~ exponent? ~ (mul_sign ~ atomic_unit ~ exponent?)* }
atomic_unit = @{ (!div_sign ~ !mul_sign ~ !superscript ~ alpha)+ ~ ("⁺" | "⁻")? ~ superscript* }
exponent = @{ "^" ~ sign? ~ digit+ }
superscript = {"⁰" | "¹" | '²'..'³' | '⁴'..'⁹'}
superscript_power = { ("⁺" | "⁻")? ~ superscript+ }

// ==================== OPERATORS ====================

// Unary operators
unary = { type_op | size_op | count_op | not_op | invert_op | ptr_op | val_at_op | unsafe_bitcast_op | unit_op | value_of_op | neg_op }
type_op = { "#type of" ~ ms_ln }
unit_op = { "#unit of" ~ ms_ln }
size_op = { "#size of" ~ ms_ln }
count_op = { "#count of" ~ ms_ln }
invert_op = { "invert" ~ ms_ln }
not_op = { kw_not ~ ms_ln }
val_at_op = { kw_unsafe ~ ms_ln ~ kw_value_at ~ ms_ln }
unsafe_bitcast_op = { kw_unsafe ~ ms_ln ~ kw_bitcast ~ ms_ln }
ptr_op = { "pointer to" ~ ms_ln }
value_of_op = { "value of" ~ ms_ln }
// Unary minus: a `-` followed by a digit is a negative numeric literal
// (absorbed by `int`/`float` via their `sign?` prefix), not a prefix operator.
// The `!digit` guard keeps `-5` and `-9223372036854775808` as `IntLiteral`s so
// `i64::MIN` literal handling in the builtins keeps working.
neg_op = { minus ~ !digit ~ os }

// Binary operator tokens. The order here only disambiguates which operator is
// recognized at a given position (e.g. `>=` before `>`); it does NOT encode
// precedence or associativity.
logical_or = { "or" }
logical_and = { "and" }
logical_xor = { "xor" | "⊻" }
bitwise_and = { "bitwise" ~ ms_ln ~ "and" }
bitwise_or = { "bitwise" ~ ms_ln ~ "or" }
bitwise_xor = { "bitwise" ~ ms_ln ~ "xor" }
unsigned_left_shift = { "unsigned" ~ ms_ln ~ "left" ~ ms_ln ~ "shift" }
unsigned_right_shift = { "unsigned" ~ ms_ln ~ "right" ~ ms_ln ~ "shift" }
signed_left_shift = { "signed" ~ ms_ln ~ "left" ~ ms_ln ~ "shift" }
signed_right_shift = { "signed" ~ ms_ln ~ "right" ~ ms_ln ~ "shift" }
equality = { "==" | "!=" | "≠" }
comparison = { ">=" | "<=" | "≥" | "≤" | ">" | "<" }
addition = { "+" | "-" }
multiplication = { "*" | "/" | "%" | "÷" | "⨯" | "cross" | "⋅" | "dot" }
power = { "^" }
append = { "~" }

// Postfix operators
conversion = { kw_as ~ ms ~ type_name }
member_access = { "." ~ (fn_call | single_identifier) }
unsafe_bitcast_wrapper = { "unsafe bitcast" }
has_value_op = { "has value" }
has_no_value_op = { "has no value" }
try_propagate_op = { "?" }

// Operator classification for `infix`. This flat list does NOT establish
// precedence or associativity — those are applied by the Pratt parser in
// `src/ast/expr_parser.rs` (see `PRATT_PARSER`).
infix = _{ logical_or | logical_and | logical_xor | bitwise_and | bitwise_or | bitwise_xor | equality | comparison | addition | multiplication | unsigned_left_shift | unsigned_right_shift | signed_left_shift | signed_right_shift | power | append }
prefix = _{ unary }
postfix = _{ member_access | arr_index | superscript_power | conversion | unsafe_bitcast_wrapper | has_no_value_op | has_value_op | try_propagate_op }

// Compiler constants
comp_const = { _comp_main | _comp_file | _comp_line | _comp_time | _comp_ver | _comp_fn_name | _posix | _windows | _debug | _mode }
_comp_main = { "#main" }
_comp_file = { "#source_file" }
_comp_line = { "#source_line" }
_comp_time = { "#compile_time" }
_comp_ver = { "#compiler_version" }
_comp_fn_name = { "#function_name" }
_posix = { "#posix" }
_windows = { "#windows" }
_debug = { "#debug" }
_mode = { "#mode" }

// ==================== EXPRESSIONS ====================
// Expression parsing. Precedence and associativity are applied by the Pratt
// parser in `src/ast/expr_parser.rs`, not by this flat rule.

expression = { os ~ prefix? ~ primary ~ (os? ~ postfix)* ~ (os ~ infix ~ os ~ prefix? ~ primary ~ (os? ~ postfix)*)* }

nothing_expr = { kw_nothing }
has_errors_expr = { "errors has messages" }
last_error_expr = { "last error" }

primary = _{
    nothing_expr |
    has_errors_expr |
    last_error_expr |
    h_literal | c_literal | triple_string | s_literal | b_literal | n_literal | a_literal | comp_const |
    allocate_expr |
    fn_call | single_identifier |
    "(" ~ os ~ expression ~ os ~ ")"
}

// Memory allocation expression: allocate(size_expr)
// Returns a pointer to the newly allocated heap memory.
allocate_expr = { kw_allocate ~ "(" ~ os ~ expression ~ os ~ ")" }

// ==================== CONTROL FLOW ====================
// Conditional and looping constructs

// Conditions
condition = { (kw_not ~ ms_ln)? ~ expression }

// Stmt block: a sequence of statements (used by if/else branches)
stmt_block = { statement ~ (sd ~ statement)* }

// Conditional statements
if_stmt = {
  statement_comments ~
  kw_if ~ ms_ln ~ condition ~ ms_ln ~ stmt_block ~

  // The `if_stmt` rule parses `else if` and the AST stores
  // `IfStmt.else_if_branches` so the semantic analyzer can emit a clear, actionable
  // error instead of a cryptic parse failure or a silent nested-`if`
  // reinterpretation (which would reintroduce the dangling-else ambiguity). This is
  // the same parse-then-reject-with-a-good-message pattern used for `when`'s
  // unsupported `else` branch

  (ms_ln ~ "else if" ~ ms_ln ~ condition ~ ms_ln ~ stmt_block)* ~
  (ms_ln ~ "else" ~ ms_ln ~ stmt_block)? ~
  ms_ln ~ "end if" ~
  (info)?
}

// When statement: one-sided action (no else)
// When statement: one-sided action (no else)
//
// The optional `else` arm exists solely to prevent a cryptic parser error
// when a user mistakenly writes `else` inside a `when` block. The parser
// accepts it and the semantic analyzer produces a clear error message:
//   "`when` does not support an `else` branch. Either use `if` instead of
//    `when`, or remove the `else`."
when_stmt = {
  statement_comments ~
  kw_when ~ ms_ln ~ condition ~ ms_ln ~ stmt_block ~
  (ms_ln ~ "else" ~ (ms_ln ~ stmt_block)?)? ~
  ms_ln ~ "end when" ~
  (info)?
}

// No-op statements: intentional empty or deferred code
move_on_stmt = { statement_comments ~ kw_move_on ~ (info)? }
missing_code_stmt = { statement_comments ~ kw_missing_code ~ (info)? }

// Memory release statement: release pointer_expr
release_stmt = { statement_comments ~ kw_release ~ ms ~ expression ~ (info)? }

// Deferrable statement: statements valid inside `on exit`.
// Must not recursively contain `on_exit_stmt` (avoid left recursion).
deferrable_statement = _{ imperative_statement | runtime_io_statement }

// On-exit statement: registers a statement to run when the enclosing function exits.
// The deferred statement runs before every return and at end-of-function.
on_exit_stmt = { statement_comments ~ kw_on_exit ~ ms ~ deferrable_statement ~ (info)? }

// Pattern matching over enum values
switch_case = {
  kw_case ~ ms_ln ~ switch_pattern ~ ":" ~ ms_ln ~ stmt_block
}

switch_default = {
  kw_default ~ ":" ~ ms_ln ~ stmt_block
}

// A switch case pattern is one of:
//   - a boolean literal (`true`/`false`), tried first so it is never mistaken
//     for an enum variant named `true`/`false`,
//   - an enum variant pattern (`Circle(r)`, `Point`, `Rect(_, h)`),
//   - a literal value expression (`200`, `"Saturday"`, `'x'`, `3.14 <m>`).
// Non-literal expressions are rejected by the semantic analyzer with a clear error.
switch_pattern = {
  b_literal | switch_variant_pattern | expression
}

switch_variant_pattern = {
  single_identifier ~ ("(" ~ os_ln ~ switch_pattern_field ~ (os_ln ~ "," ~ os_ln ~ switch_pattern_field)* ~ (os_ln ~ ",")? ~ os_ln ~ ")")?
}

switch_pattern_field = { single_identifier | "_" }

switch_stmt = {
  statement_comments ~
  kw_switch ~ ms_ln ~ expression ~
  &(ms_ln ~ (switch_case | switch_default)) ~
  (ms_ln ~ switch_case)* ~
  (ms_ln ~ switch_default)? ~
  ms_ln ~ "end switch" ~
  (info)?
}

// Match arm: case guard with optional body
match_arm = {
  kw_when ~ ms_ln ~ condition ~ ":" ~ ms_ln ~ stmt_block
}

match_default = {
  "else" ~ ":" ~ ms_ln ~ stmt_block
}

// Match statement: conditional branching with multiple arms
match_stmt = {
  statement_comments ~
  kw_match ~
  &(ms_ln ~ (match_arm | match_default)) ~
  (ms_ln ~ match_arm)* ~
  (ms_ln ~ match_default)? ~
  ms_ln ~ "end match" ~
  (info)?
}

// Looping statements
loop_stmt = {
  statement_comments ~
  kw_loop ~ (ms_ln ~ range)? ~ (ms ~ "when" ~ ms_ln ~ condition)? ~
  ms_ln ~ statement ~ (sd ~ statement)* ~
  ms_ln ~ "end loop" ~ (ms ~ "when" ~ ms_ln ~ condition)? ~
  (info)?
}

range = {
  kw_var ~ ms_ln ~ single_identifier ~ ms_ln ~ kw_as ~ ms_ln ~ type_name ~
  ms_ln ~ "from" ~ ms_ln ~ expression ~ ms_ln ~ kw_to ~ ms_ln ~ expression ~
  (ms_ln ~ "step" ~ ms_ln ~ expression)?
}

exit_loop = { statement_comments ~ kw_exit_loop ~ (info)? }
rewind = { statement_comments ~ kw_rewind ~ (info)? }

assert_stmt = { statement_comments ~ kw_assert ~ ms_ln ~ expression ~ (info)? }

// ==================== FUNCTIONS ====================
// Function definitions and calls

fn_call = {
  statement_comments ~
  qualified_identifier ~
  "(" ~ os_ln ~ (kw_nothing | (expression ~ ( os_ln ~ "," ~ os_ln ~ expression)* ~ ( os_ln ~ ",")?))? ~ os_ln ~ ")" ~
  (info)? ~
  (os ~ &"<" ~ unit)?
}

fn_parameter = { ((kw_copy | kw_ref) ~ ms_ln)? ~ single_identifier ~ ms_ln ~ kw_as ~ ms_ln ~ type_name ~ (ms_ln ~ kw_in ~ ms_ln ~ unit)? }
parameters = { fn_parameter ~ (os_ln ~ "," ~ os_ln ~ fn_parameter)* ~ (os_ln ~ ",")? }
return_type = { kw_nothing | type_name }

fn_def = {
  statement_comments ~
  (kw_export ~ ms_ln)? ~ kw_fn ~ ms_ln ~ single_identifier ~ os_ln ~
  ("(" ~ os_ln ~ kw_nothing? ~ os_ln ~ ")" | "(" ~ os_ln ~ parameters ~ os_ln ~ ")") ~
  ms_ln ~ kw_returns ~ ms_ln ~ return_type ~ (ms_ln ~ kw_in ~ ms_ln ~ unit)? ~
  ms_ln ~ statement ~ (sd ~ statement)* ~
  ms_ln ~ "end fn" ~
  (info)?
}

// Function signature: declares function interface without implementation
// Syntax: [import] fn signature identifier(...) returns type [in unit]
// Example: import fn signature sqrt(x as f64) returns f64
// Note: Function signatures cannot be exported. Export implementations with 'fn var' instead.
fn_signature = {
  statement_comments ~
  (kw_import ~ ms_ln)? ~ "fn signature" ~ ms_ln ~ single_identifier ~ os_ln ~
  ("(" ~ os_ln ~ kw_nothing? ~ os_ln ~ ")" | "(" ~ os_ln ~ parameters ~ os_ln ~ ")") ~
  ms_ln ~ kw_returns ~ ms_ln ~ return_type ~ (ms_ln ~ kw_in ~ ms_ln ~ unit)? ~
  (info)?
}

return_stmt = { statement_comments ~ kw_return ~ (ms ~ expression)? ~ (info)?}

// ==================== DEFINITIONS AND DECLARATIONS ====================
// Variable definitions (with initialization) and declarations (without)
var_symbol = { kw_var ~ ms_ln ~ single_identifier ~
(ms_ln ~ kw_as ~ ms_ln ~ type_name)? ~
(ms_ln ~ kw_in ~ ms_ln ~ unit)? }

decl_symbol = { kw_decl ~ ms_ln ~ single_identifier ~
(ms_ln ~ kw_as ~ ms_ln ~ type_name)? ~
(ms_ln ~ kw_in ~ ms_ln ~ unit)? }

// Variable definition: declares and initializes a variable with a value
// Syntax: [export|import] var identifier [as type] [in unit] = expression
// Example: var x as u8 = 5
var = {
  statement_comments ~
  ((kw_export | kw_import) ~ ms_ln)? ~ var_symbol ~ os ~ "=" ~ os ~ expression ~
  (info)?

}

// Unsafe variable declaration: declares a variable without initialization
// This is explicitly marked unsafe because uninitialized variables are dangerous
// Syntax: unsafe [export|import] decl identifier [as type] [in unit]
// Example: unsafe decl x as u8
unsafe_decl = {
  statement_comments ~
  kw_unsafe ~ ms ~ ((kw_export | kw_import) ~ ms)? ~ decl_symbol ~
  (info)?
}

// ==================== TYPE DEFINITIONS ====================
// Composite types that group multiple fields together.
// Like C struct, simpler than C++ class.

// Type field definition
type_field = { (kw_private ~ ms_ln)? ~ single_identifier ~ ms_ln ~ kw_as ~ ms_ln ~ type_name ~ (ms_ln ~ kw_in ~ ms_ln ~ unit)? ~ (info)?}

// Type definition: groups multiple typed fields
// Syntax: [export] type identifier
//     field1 as type1
//     field2 as type2
// end type
// Example: type Person
//     name as text
//     age as i32
// end type
type_def = {
  statement_comments ~
  (kw_export ~ ms_ln)? ~ kw_type ~ ms_ln ~ single_identifier ~
  ms_ln ~ type_field ~ (sd ~ type_field)* ~
  ms_ln ~ "end type" ~
  (info)?
}

// ==================== ENUM DEFINITIONS ====================
// Enum variants can carry typed fields (like Rust enums or Haskell ADTs).

// Enum variant field: just a type name (anonymous field)
enum_variant_field = { type_name ~ (ms_ln ~ kw_in ~ ms_ln ~ unit)? }

// Enum variant: name with optional fields (no trailing info — handled by enum_def)
// Negative lookahead prevents bare "end" from being consumed as a variant name
enum_variant = { !("end" ~ (s | NEWLINE)) ~ single_identifier ~ ("(" ~ os_ln ~ enum_variant_field ~ (os_ln ~ "," ~ os_ln ~ enum_variant_field)* ~ (os_ln ~ ",")? ~ os_ln ~ ")")? }

// Enum definition: like a type but variants can carry data
enum_def = {
  statement_comments ~
  (kw_export ~ ms_ln)? ~ kw_enum ~ ms_ln ~ single_identifier ~
  ms_ln ~ enum_variant ~ (ms_ln ~ enum_variant)* ~
  ms_ln ~ "end enum" ~
  (info)?
}

// ==================== INPUT/OUTPUT ====================
// Runtime I/O operations

write = { "write" }
warn = { "warn" }
alert = { "alert" }
read = { "read" }
write_inline = { "write inline" ~ !identifier_continue }
debug_stmt = _{ kw_debug }

stdout = { statement_comments ~ (write_inline | write) ~ ms ~ expression ~ (info)?}
stderr = { statement_comments ~ warn ~ ms ~ expression ~ (info)?}
alert_stmt = { statement_comments ~ alert ~ ms ~ expression ~ (info)?}
stdin = { statement_comments ~ read ~ ms ~ single_identifier ~ ms ~ kw_as ~ ms ~ text ~ (info)?}
debug_output = { statement_comments ~ debug_stmt ~ ms ~ expression ~ (info)?}
log_output = { statement_comments ~ kw_log ~ ms ~ expression ~ (info)?}

// ==================== COMPILE-TIME FEATURES ====================
// Compile-time evaluation and metaprogramming

// Compile-time statements
ct_fail = { statement_comments ~ "#fail" ~ ms_ln ~ s_literal ~ (info)? }
ct_warn = { statement_comments ~ "#warn" ~ ms_ln ~ s_literal ~ (info)? }
ct_if = {
  statement_comments ~
  "#if" ~ ms_ln ~ condition ~ ms_ln ~ stmt_block ~
  (ms_ln ~ "#else if" ~ ms_ln ~ condition ~ ms_ln ~ stmt_block)* ~
  (ms_ln ~ "#else" ~ ms_ln ~ stmt_block)? ~
  ms_ln ~ "#end if" ~
  (info)?
}

// Compile-time when: one-sided guard (#when ... #end when)
ct_when = {
  statement_comments ~
  "#when" ~ ms_ln ~ condition ~ ms_ln ~ stmt_block ~
  ms_ln ~ "#end when" ~
  (info)?
}

// Compile-time match arm: #when <condition>: <body>
ct_match_arm = {
  "#when" ~ ms_ln ~ condition ~ ":" ~ ms_ln ~ stmt_block
}

ct_match_default = {
  "#else" ~ ":" ~ ms_ln ~ stmt_block
}

// Compile-time match: ordered condition chain (#match ... #end match)
ct_match = {
  statement_comments ~
  "#match" ~
  &(ms_ln ~ (ct_match_arm | ct_match_default)) ~
  (ms_ln ~ ct_match_arm)* ~
  (ms_ln ~ ct_match_default)? ~
  ms_ln ~ "#end match" ~
  (info)?
}

// Compile-time switch case: #case <literal>: <body>
ct_switch_case = {
  "#case" ~ ms_ln ~ expression ~ ":" ~ ms_ln ~ stmt_block
}

ct_switch_default = {
  "#default" ~ ":" ~ ms_ln ~ stmt_block
}

// Compile-time switch: value dispatch (#switch ... #end switch)
ct_switch = {
  statement_comments ~
  "#switch" ~ ms_ln ~ expression ~
  &(ms_ln ~ (ct_switch_case | ct_switch_default)) ~
  (ms_ln ~ ct_switch_case)* ~
  (ms_ln ~ ct_switch_default)? ~
  ms_ln ~ "#end switch" ~
  (info)?
}

// ==================== MODULE SYSTEM ====================
// Module imports for multi-file organization

// Dependency origin: `std` (installed standard library) or `local` (source-relative).
origin = { "std" | "local" }

// List of imported symbols: `sin, cos` for specific imports
use_import_list = { single_identifier ~ (os_ln ~ "," ~ os_ln ~ single_identifier)* }

// Use statement: `use all from std.math` (all symbols) or `use sin, cos from local.math` (specific symbols)
use_stmt = {
  statement_comments ~
  kw_use ~ ms_ln ~
  (kw_all | use_import_list) ~ ms_ln ~ kw_from ~ ms_ln ~
  origin ~ os_ln ~ "." ~ os_ln ~ qualified_identifier ~
  (info)?
}

// ==================== ASSIGNMENT ====================
// Assignment to existing variables

assign = {
  statement_comments ~
  single_identifier ~ ("." ~ single_identifier)* ~ arr_index? ~ os ~ "=" ~ os ~ expression ~
  (info)?
}

// Compound assignment operators
compound_op = { "+=" | "-=" | "*=" | "/=" | "%=" }

compound_assign = {
  statement_comments ~
  single_identifier ~ ("." ~ single_identifier)* ~ arr_index? ~ os ~ compound_op ~ os ~ expression ~
  (info)?
}

value_at_assign = {
  statement_comments ~ kw_unsafe ~ ms_ln ~ kw_value_at ~ ms_ln ~ expression ~ os ~ "=" ~ os ~ expression ~
  (info)?
}


// Error stack statements (write/warn placed before generic stdout/stderr via ordered choice)
error_push_stmt   = { "add error" ~ ms ~ expression }
error_alert_stmt  = { "alert error messages" }
error_statement = _{ error_push_stmt | error_alert_stmt | alert_stmt }

// Test suite: a named group of test cases (must be the last top-level statement).
// Test suites/cases are regular statements (present in the IR), not #-prefixed
// compile-time statements.
// `statement_comments` collects comment lines directly preceding the case as
// leading comments on the case node and tolerates the indentation between the
// comment block and the keyword. A comment separated from the next case by a
// blank line is NOT consumed here and falls through to the suite's `info`
// alternative as a standalone comment.
test_case = {
  statement_comments ~
  kw_test_case ~ ms_ln ~ single_identifier ~
  ms_ln ~ stmt_block ~
  ms_ln ~ "end test case" ~
  (info)?
}

// The suite body is a list of suite items: test cases, suite-level `var`/`fn`
// declarations, and standalone `info` (comment/doc) nodes. Comments directly
// above an item attach to that item (via each item's `statement_comments`
// prefix), while any other comment line — including one between the last item
// and `end test suite` — is a standalone `info` node of the suite.
//
// Suite-level `var`/`fn` declarations are shared by every case in the suite and
// invisible to non-test code and other suites. Semantic analysis enforces that
// declarations appear before the first test case.
suite_item = _{ test_case | var | fn_def | info }

test_suite = {
  statement_comments ~
  kw_test_suite ~ ms_ln ~ single_identifier ~
  ms_ln ~ suite_item ~ (sd ~ suite_item)* ~
  ms_ln ~ "end test suite" ~
  (info)?
}

// ==================== STATEMENT CLASSIFICATION ====================
// High-level statement organization

// Statement categories
var_and_declaration_statement = _{ use_stmt | type_def | enum_def | var | unsafe_decl | fn_signature | fn_def }
imperative_statement = _{ compound_assign | value_at_assign | assign | release_stmt | fn_call | exit_program }
conditional_statement = _{ if_stmt | when_stmt | switch_stmt | match_stmt }
noop_statement = _{ move_on_stmt | missing_code_stmt | on_exit_stmt }
looping_statement = _{ loop_stmt | return_stmt | exit_loop | rewind | assert_stmt }
compile_time_statement = _{ ct_if | ct_fail | ct_warn | ct_when | ct_match | ct_switch }
runtime_io_statement = _{ stdout | stderr | stdin | log_output | debug_output }
test_statement = _{ test_suite }

// Main statement rule
// Keyword-based statements must precede identifier-based statements (imperative_statement)
// because Lale has no reserved keywords — `write`, `alert`, etc. are valid identifiers.
// error_statement precedes runtime_io_statement because `write error messages`
// must match before `write <expr>` (write_line in stdout).
statement = _{
  var_and_declaration_statement | error_statement | runtime_io_statement | conditional_statement |
  noop_statement | looping_statement | compile_time_statement | test_statement | imperative_statement | info
}

// ==================== LETTER RANGES ====================
// Unicode ranges - comprehensive letter support
// All ranges follow Unicode letter categories (Ll, Lm, Lo, Lt, Lu) + Letter_Numeral (Nl)

// Comprehensive letter ranges (ordered by parsing frequency for efficiency)
letter_ranges = {
  // SCIENTIFIC COMPUTING PRIORITY (most frequent in Lale's target domain)
  // Latin Extended (accented letters): U+00C0-U+00FF — common in scientific names/notation
  latin1_safe |
  // Greek and Coptic letters (numeral signs, tonos, question mark, and symbols excluded)
  '\u{0370}'..'\u{0373}' | '\u{0376}'..'\u{0377}' | '\u{037B}'..'\u{037D}' | "\u{037F}" |
  "\u{0386}" | '\u{0388}'..'\u{038A}' | "\u{038C}" | '\u{038E}'..'\u{03A1}' | '\u{03A3}'..'\u{03AB}' |
  '\u{03AC}'..'\u{03CE}' | '\u{03D0}'..'\u{03E1}' | '\u{03E2}'..'\u{03EF}' | '\u{03F0}'..'\u{03F5}' | '\u{03F7}'..'\u{03FF}' |
  // Letter Numerals (Roman): U+2160-U+2188 — U+2189+ are number signs, not letters
  '\u{2160}'..'\u{2188}' |

  // EAST ASIAN (very high speaker/user population)
  // CJK Unified Ideographs: U+4E00-U+9FFF (all letters)
  '\u{4E00}'..'\u{9FFF}' |
  // Hiragana + Katakana letters (combining marks and middle dot excluded)
  '\u{3041}'..'\u{3096}' | '\u{309D}'..'\u{309F}' | '\u{30A1}'..'\u{30FA}' | '\u{30FC}'..'\u{30FF}' |
  // Hangul Jamo: U+1100-U+11FF (all letters)
  '\u{1100}'..'\u{11FF}' |
  // Hangul Syllables: U+AC00-U+D7AF (all letters)
  '\u{AC00}'..'\u{D7AF}' |
  // CJK Compatibility: U+F900-U+FAFF (all letters)
  '\u{F900}'..'\u{FAFF}' |

  // CYRILLIC (major European/Asian script)
  // Cyrillic letters — U+0482 (sign) and U+0483-U+0489 (combining marks) excluded
  '\u{0400}'..'\u{0481}' | '\u{048A}'..'\u{04FF}' |

  // MIDDLE EASTERN & SOUTH ASIAN
  // Arabic letters — digits (U+0660-U+0669, U+06F0-U+06F9), punctuation, and marks excluded
  '\u{0620}'..'\u{063F}' | "\u{0640}" | '\u{0641}'..'\u{064A}' | '\u{066E}'..'\u{066F}' |
  '\u{0671}'..'\u{06D3}' | "\u{06D5}" | '\u{06E5}'..'\u{06E6}' | '\u{06EE}'..'\u{06EF}' | '\u{06FA}'..'\u{06FF}' |
  // Hebrew letters — cantillation marks and punctuation excluded
  '\u{05D0}'..'\u{05EA}' | '\u{05EF}'..'\u{05F2}' |
  // Syriac letters — punctuation (U+0700-U+070D) and combining marks excluded
  '\u{0710}'..'\u{072F}' | '\u{074D}'..'\u{074F}' |
  // Thaana letters — combining marks excluded
  '\u{0780}'..'\u{07A5}' | "\u{07B1}" |
  // Devanagari letters — digits (U+0966-U+096F) and matras/marks excluded
  '\u{0904}'..'\u{0939}' | "\u{093D}" | "\u{0950}" | '\u{0958}'..'\u{0961}' | "\u{0971}" | '\u{0972}'..'\u{097F}' |
  // Bengali letters
  '\u{0985}'..'\u{098C}' | '\u{098F}'..'\u{0990}' | '\u{0993}'..'\u{09A8}' | '\u{09AA}'..'\u{09B0}' | "\u{09B2}" |
  '\u{09B6}'..'\u{09B9}' | "\u{09BD}" | "\u{09CE}" | '\u{09DC}'..'\u{09DD}' | '\u{09DF}'..'\u{09E1}' | '\u{09F0}'..'\u{09F1}' |
  // Gurmukhi letters
  '\u{0A05}'..'\u{0A0A}' | '\u{0A0F}'..'\u{0A10}' | '\u{0A13}'..'\u{0A28}' | '\u{0A2A}'..'\u{0A30}' | '\u{0A32}'..'\u{0A33}' |
  '\u{0A35}'..'\u{0A36}' | '\u{0A38}'..'\u{0A39}' | '\u{0A59}'..'\u{0A5C}' | "\u{0A5E}" | '\u{0A72}'..'\u{0A74}' |
  // Gujarati letters
  '\u{0A85}'..'\u{0A8D}' | '\u{0A8F}'..'\u{0A91}' | '\u{0A93}'..'\u{0AA8}' | '\u{0AAA}'..'\u{0AB0}' | '\u{0AB2}'..'\u{0AB3}' |
  '\u{0AB5}'..'\u{0AB9}' | "\u{0ABD}" | "\u{0AD0}" | '\u{0AE0}'..'\u{0AE1}' | "\u{0AF9}" |
  // Oriya letters
  '\u{0B05}'..'\u{0B0C}' | '\u{0B0F}'..'\u{0B10}' | '\u{0B13}'..'\u{0B28}' | '\u{0B2A}'..'\u{0B30}' | '\u{0B32}'..'\u{0B33}' |
  '\u{0B35}'..'\u{0B39}' | "\u{0B3D}" | '\u{0B5C}'..'\u{0B5D}' | '\u{0B5F}'..'\u{0B61}' | "\u{0B71}" |
  // Tamil letters — digits (U+0BE6-U+0BEF) excluded
  '\u{0B85}'..'\u{0B8A}' | '\u{0B8E}'..'\u{0B90}' | '\u{0B92}'..'\u{0B95}' | '\u{0B99}'..'\u{0B9A}' | "\u{0B9C}" |
  '\u{0B9E}'..'\u{0B9F}' | '\u{0BA3}'..'\u{0BA4}' | '\u{0BA8}'..'\u{0BAA}' | '\u{0BAE}'..'\u{0BB9}' | "\u{0BD0}" | "\u{0BD7}" |
  // Telugu letters — digits (U+0C66-U+0C6F) excluded
  '\u{0C05}'..'\u{0C0C}' | '\u{0C0E}'..'\u{0C10}' | '\u{0C12}'..'\u{0C28}' | '\u{0C2A}'..'\u{0C39}' | "\u{0C3D}" |
  '\u{0C58}'..'\u{0C5A}' | '\u{0C60}'..'\u{0C61}' |
  // Kannada letters — digits (U+0CE6-U+0CEF) excluded
  '\u{0C85}'..'\u{0C8C}' | '\u{0C8E}'..'\u{0C90}' | '\u{0C92}'..'\u{0CA8}' | '\u{0CAA}'..'\u{0CB3}' | '\u{0CB5}'..'\u{0CB9}' |
  "\u{0CBD}" | "\u{0CDE}" | '\u{0CE0}'..'\u{0CE1}' |
  // Malayalam letters — digits (U+0D66-U+0D6F) excluded
  '\u{0D05}'..'\u{0D0C}' | '\u{0D0E}'..'\u{0D10}' | '\u{0D12}'..'\u{0D3A}' | "\u{0D3D}" | "\u{0D4E}" |
  '\u{0D54}'..'\u{0D56}' | '\u{0D5F}'..'\u{0D61}' | '\u{0D7A}'..'\u{0D7F}' |
  // Sinhala letters — digits (U+0DE6-U+0DEF) excluded
  '\u{0D85}'..'\u{0D96}' | '\u{0D9A}'..'\u{0DB1}' | '\u{0DB3}'..'\u{0DBB}' | "\u{0DBD}" | '\u{0DC0}'..'\u{0DC6}' |

  // SOUTHEAST ASIAN
  // Thai letters — digits (U+0E50-U+0E59) and marks excluded
  '\u{0E01}'..'\u{0E30}' | '\u{0E32}'..'\u{0E33}' | '\u{0E40}'..'\u{0E46}' |
  // Lao letters — digits (U+0ED0-U+0ED9) and marks excluded
  '\u{0E81}'..'\u{0E82}' | "\u{0E84}" | '\u{0E87}'..'\u{0E88}' | "\u{0E8A}" | "\u{0E8D}" | '\u{0E94}'..'\u{0E97}' |
  '\u{0E99}'..'\u{0E9F}' | '\u{0EA1}'..'\u{0EA3}' | "\u{0EA5}" | "\u{0EA7}" | '\u{0EAA}'..'\u{0EAB}' | '\u{0EAD}'..'\u{0EB0}' |
  '\u{0EB2}'..'\u{0EB3}' | "\u{0EBD}" | '\u{0EC0}'..'\u{0EC4}' | "\u{0EC6}" |
  // Tibetan letters — digits (U+0F20-U+0F33) and marks excluded
  '\u{0F40}'..'\u{0F47}' | '\u{0F49}'..'\u{0F6C}' | '\u{0F88}'..'\u{0F8C}' |
  // Myanmar letters — digits (U+1040-U+1049) and punctuation excluded
  '\u{1000}'..'\u{102A}' | "\u{103F}" | '\u{1050}'..'\u{1055}' | '\u{105A}'..'\u{105D}' | "\u{1061}" |
  '\u{1065}'..'\u{1066}' | '\u{106E}'..'\u{1070}' | '\u{1075}'..'\u{1081}' | "\u{108E}" | "\u{109C}" |

  // CAUCASIAN & OTHER
  // Georgian letters — paragraph separator (U+10FB) excluded
  '\u{10A0}'..'\u{10C5}' | "\u{10C7}" | "\u{10CD}" | '\u{10D0}'..'\u{10FA}' | '\u{10FC}'..'\u{10FF}' |
  // Armenian letters — modifiers and punctuation excluded
  '\u{0531}'..'\u{0556}' | '\u{0561}'..'\u{0587}'
}

// Latin Extended: À-ÖØ-öø-ÿ (U+00C0-U+00FF)
latin1_safe = {
  '\u{00C0}'..'\u{00D6}' | '\u{00D8}'..'\u{00F6}' | '\u{00F8}'..'\u{00FF}'
}

// Combining marks (Mn, Mc): allowed in identifier_continue only
// Latin combining diacriticals: U+0300-U+036F
// Latin extended combining: U+1AB0-U+1AFF, U+1DC0-U+1DFF
// combining right arrow above (U+20D7) added for vector notation: v⃗, F⃗, r⃗
combining_marks = {
  '\u{0300}'..'\u{036F}' | '\u{1AB0}'..'\u{1AFF}' | '\u{1DC0}'..'\u{1DFF}' |
  '\u{20D7}'..'\u{20D7}'
}
